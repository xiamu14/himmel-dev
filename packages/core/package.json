{
  "name": "himmel",
  "version": "0.0.2-alpha.6",
  "description": "A small TypeScript UI runtime for AI-friendly interfaces.",
  "keywords": [
    "dom",
    "runtime",
    "signals",
    "typescript",
    "ui"
  ],
  "homepage": "https://github.com/xiamu14/himmel-dev#readme",
  "bugs": {
    "url": "https://github.com/xiamu14/himmel-dev/issues"
  },
  "license": "ISC",
  "author": "ben",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiamu14/himmel-dev.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "./dist/index.es.js",
  "types": "./dist",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "types": "./dist/index.d.ts"
    },
    "./signal": {
      "import": "./dist/signal.es.js",
      "types": "./dist/signal.d.ts"
    },
    "./dom": {
      "import": "./dist/dom.es.js",
      "types": "./dist/dom.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "rimraf dist && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "release": "renew-it"
  },
  "dependencies": {
    "fast-array-diff": "^1.1.0",
    "lodash.clonedeep": "^4.5.0"
  },
  "devDependencies": {
    "@types/lodash.clonedeep": "^4.5.9",
    "@types/node": "^25.9.1",
    "@unocss/preset-uno": "^66.7.0",
    "renew-it": "^1.5.5",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "unocss": "^66.7.0",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1"
  }
}
